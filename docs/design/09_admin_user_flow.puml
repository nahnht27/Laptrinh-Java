@startuml
title Admin User Flow

start

repeat
    :Admin Login;

    if (Login successful?) then (Yes)
    else (No)
        :Display Login Error;
    endif

repeat while (Login failed?) is (Yes) not (No)

:Dashboard;

repeat
    :Admin Menu;
    :Select Admin Function;

    switch (Selected function?)

    case (Heritage Site Management)
        :View / Search Sites;
        :Create / Update / Delete Site;

    case (Artifact Management)
        :View / Search Artifacts;
        :Create / Update / Delete Artifact;

    case (Multimedia Management)
        :View Multimedia;
        :Upload / Manage Multimedia;

    case (Beacon Management)
        :View / Search Beacons;
        :Register / Update / Delete Beacon;
        :Configure Beacon;
        :Manage Deployment Location on Interactive Map;
        :Assign Beacon to Site / Artifact;

    case (Translation)
        :Select Content & Language;
        :Manage Translation;

    case (Feedback Management)
        :View Feedback;
        :Moderate Feedback;

    case (Analytics Dashboard)
        :View Analytics Dashboard;

    case (Export Reports)
        :Export Statistical Reports;

    case (Logout)
        :Logout;

    endswitch

repeat while (Continue managing system?) is (Yes) not (No)

stop

@enduml